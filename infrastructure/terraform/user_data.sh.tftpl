#!/bin/bash
set -euxo pipefail

# Redirect logs to /var/log/user-data.log and console
exec > >(tee -a /var/log/user-data.log | logger -t user-data -s 2>/dev/console) 2>&1

echo "[user-data] Bootstrapping application on Amazon Linux 2023..."

APP_DIR="/opt/app"
mkdir -p "$APP_DIR"
cd "$APP_DIR"

# Wait for artifact to be available in S3 (retry loop in case ASG launches immediately)
echo "[user-data] Downloading application bundle from s3://${artifact_bucket}/${artifact_key}..."

MAX_RETRIES=60
RETRY_COUNT=0
until aws s3 cp "s3://${artifact_bucket}/${artifact_key}" /tmp/app-bundle.tar.gz --region "${aws_region}" || [ $RETRY_COUNT -eq $MAX_RETRIES ]; do
  echo "[user-data] Artifact download waiting ($RETRY_COUNT/$MAX_RETRIES)... retrying in 10s"
  RETRY_COUNT=$((RETRY_COUNT + 1))
  sleep 10
done

if [ ! -f /tmp/app-bundle.tar.gz ]; then
  echo "[user-data] ERROR: Failed to download application bundle after retries."
  exit 1
fi

echo "[user-data] Extracting application bundle..."
tar -xzf /tmp/app-bundle.tar.gz -C "$APP_DIR"
rm -f /tmp/app-bundle.tar.gz

# Link pre-bundled standalone node binary
if [ -d "$APP_DIR/node-bin" ]; then
  ln -sf "$APP_DIR/node-bin/node" /usr/local/bin/node
  ln -sf "$APP_DIR/node-bin/npm" /usr/local/bin/npm || true
  ln -sf "$APP_DIR/node-bin/npx" /usr/local/bin/npx || true
fi

# Ensure ec2-user ownership
chown -R ec2-user:ec2-user "$APP_DIR"

# Create production .env file
cat <<'EOF_ENV' > "$APP_DIR/.env"
NODE_ENV=production
PORT=${app_port}
DB_HOST=${db_host}
DB_PORT=${db_port}
DB_NAME=${db_name}
DB_USER=${db_user}
DB_PASSWORD=${db_password}
DB_SSL=true
JWT_SECRET=${jwt_secret}
JWT_EXPIRES_IN=24h
LOG_LEVEL=info
CORS_ORIGIN=*
EOF_ENV

chmod 600 "$APP_DIR/.env"
chown ec2-user:ec2-user "$APP_DIR/.env"

# Run database migrations with retry (Postgres might take a few moments to accept connections)
echo "[user-data] Running database migrations..."
MIGRATE_RETRIES=15
MIGRATE_COUNT=0
until /usr/local/bin/node "$APP_DIR/migrations/runner.js" || [ $MIGRATE_COUNT -eq $MIGRATE_RETRIES ]; do
  echo "[user-data] Migration failed, retrying in 10s ($MIGRATE_COUNT/$MIGRATE_RETRIES)..."
  MIGRATE_COUNT=$((MIGRATE_COUNT + 1))
  sleep 10
done

# Create systemd service unit
echo "[user-data] Creating systemd service unit..."
cat <<'EOF_SERVICE' > /etc/systemd/system/task-backend.service
[Unit]
Description=Task Management API Backend
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/opt/app
EnvironmentFile=/opt/app/.env
ExecStart=/usr/local/bin/node /opt/app/src/server.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=task-backend

[Install]
WantedBy=multi-user.target
EOF_SERVICE

systemctl daemon-reload
systemctl enable --now task-backend.service

echo "[user-data] Bootstrap completed successfully."

