# Application Environment
NODE_ENV=development
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5433
DB_NAME=taskmanager
DB_USER=postgres
DB_PASSWORD=postgres

# PostgreSQL Container Host Port (used by compose.yaml)
POSTGRES_PORT=5433

# JWT Configuration
JWT_SECRET=development-jwt-super-secret-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=1h

# Structured Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
